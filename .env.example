# Copy this file to .env.development for local work:
#
#   cp .env.example .env.development
#
# All values here are public (they ship to the browser via NEXT_PUBLIC_* or are
# plain hostnames) - nothing secret belongs in this repo. Production values live
# in the DigitalOcean App Platform spec; CI passes its own values in ci.yml.

# Backend base URL. Local backend runs on :3000 (prod: https://api.peoply.app).
NEXT_PUBLIC_API_URL=http://localhost:3000

# This app's own URL - share links, OG tags, ICS feeds, sitemap.
# Local dev server runs on :3001 (prod: https://peoply.app).
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Remote host allowlisted for next/image.
BLOB_DOMAIN=peoply.blob.core.windows.net

# Optional, prod only, server-side: lets SSR bypass Cloudflare bot protection.
# Falls back to NEXT_PUBLIC_API_URL when unset.
# API_INTERNAL_URL=
