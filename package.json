{
  "name": "peoply-frontend",
  "private": true,
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint:biome && npm run lint:stylelint",
    "lint:stylelint": "stylelint '**/*.{css,scss}'",
    "lint:biome": "biome check .",
    "format": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@vercel/analytics": "2.0.1",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "1.102.0",
    "sharp": "0.35.3",
    "swiper": "12.1.2",
    "swr": "2.4.2",
    "typescript": "5.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "19.8.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "stylelint": "14.16.1",
    "stylelint-config-recommended-scss": "5.0.2",
    "stylelint-order": "6.0.3",
    "stylelint-scss": "5.0.0",
    "vitest": "^4.1.10"
  }
}
