{
  "name": "peoply-frontend",
  "private": true,
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build && serwist build serwist.config.mjs",
    "build:prod": "npm run build && npm prune --omit=dev",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p service-worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint:biome && npm run lint:stylelint",
    "lint:stylelint": "stylelint '**/*.{css,scss}'",
    "lint:biome": "biome check .",
    "format": "biome check --write .",
    "generate:mascot": "node scripts/generate-mascot-definition.mjs",
    "prepare": "husky"
  },
  "overrides": {
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.9"
    },
    "fast-uri": "^4.0.0",
    "js-yaml": "^5.0.0",
    "sharp": "$sharp",
    "postcss": "$postcss"
  },
  "dependencies": {
    "@fullcalendar/react": "7.0.2",
    "@serwist/next": "^9.5.12",
    "@tanstack/charts": "^0.14.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "sass": "1.102.0",
    "serwist": "^9.5.12",
    "sharp": "0.35.3",
    "swr": "2.5.1",
    "temporal-polyfill": "1.0.4",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@serwist/cli": "^9.5.12",
    "@stylistic/stylelint-plugin": "5.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.1",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "postcss": "8.5.26",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-order": "8.1.1",
    "stylelint-scss": "7.2.0",
    "vitest": "^4.1.10"
  }
}
